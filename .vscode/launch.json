{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dispatcher (API Gateway)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-dispatcher",
      "program": "${workspaceFolder}/Dispatcher/bin/Debug/net8.0/Dispatcher.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Dispatcher",
      "env": { "ASPNETCORE_URLS": "http://127.0.0.1:5000" },
      "stopAtEntry": false
    },
