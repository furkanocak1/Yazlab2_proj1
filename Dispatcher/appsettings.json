{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "gateway-auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "Match": { "Path": "/api/gateway/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/gateway" },
          { "PathPrefix": "/api" }
        ]
      },
      "gateway-event-route": {
        "ClusterId": "event-cluster",
        "Order": 1,
        "Match": { "Path": "/api/gateway/events/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/gateway" },
          { "PathPrefix": "/api" }
        ]
      },
      "gateway-ticket-route": {
        "ClusterId": "ticket-cluster",
        "Order": 1,
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/gateway/tickets/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/gateway" },
          { "PathPrefix": "/api" }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 100,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "event-route": {
        "ClusterId": "event-cluster",
        "Order": 100,
        "Match": { "Path": "/api/events/{**catch-all}" }
      },
      "ticket-route": {
        "ClusterId": "ticket-cluster",
        "Order": 100,
        "Match": { "Path": "/api/tickets/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://authservice:8080" }
        }
      },
      "event-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://eventservice:8080" }
        }
      },
      "ticket-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://ticketservice:8080" }
        }
      }
    }
  }
}